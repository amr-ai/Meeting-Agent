# Generate two different random secrets, each at least 32 characters.
ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters
BRIDGE_SIGNING_SECRET=replace-with-another-random-secret-at-least-32-characters
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
GOOGLE_API_KEY=your-google-gemini-api-key
# Explicit native Live model; errors are surfaced, never replaced with another pipeline.
GEMINI_MODEL=gemini-3.8-live
# Live uses the v1beta WebSocket endpoint; SDK 3.0 defaults to v1 otherwise.
GEMINI_API_VERSION=v1beta
GEMINI_SILENCE_DURATION_MS=300
# High restores responsive speech onset; use low only for a measured noise comparison.
GEMINI_START_SENSITIVITY=high
GEMINI_VOICE=Iapetus
INPUT_LANGUAGES=ar,en
# Local WebRTC denoising before Gemini VAD; no extra provider or model download.
VOICE_NOISE_SUPPRESSION=true
# Wake name opens a short directed conversation. 0 requires a name every turn.
MEETING_FOLLOWUP_SECONDS=30
# Keep the activated caller's conversation open across silence, until explicit stop.
MEETING_FOLLOWUP_UNTIL_STOP=true
AGENT_NAME=meeting-agent
ASSISTANT_NAME=Khaled
WAKE_NAMES=Khaled,Khalid,خالد,يا خالد
# Optional absolute path. Default is prompts/system_prompt.md within this checkout.
# PROMPT_PATH=
RECALL_API_KEY=your-recall-api-key
RECALL_REGION=us-west-2
# Workspace verification secret, created in Recall API Keys & Secrets.
RECALL_WEBHOOK_SECRET=whsec_replace-with-workspace-secret
# Only necessary for accounts using legacy Svix dashboard webhooks.
RECALL_LEGACY_WEBHOOK_SECRET=
# Public HTTPS origin for Recall; no trailing slash required.
PUBLIC_BASE_URL=https://your-public-host.example
# Meeting launcher reads this only from your local .env.
NGROK_AUTHTOKEN=
# Internal API address reachable from the worker and CLI.
API_BASE_URL=http://localhost:8000
TAVILY_API_KEY=your-tavily-api-key
# Optional paths; defaults resolve within this checkout.
# DATABASE_PATH=data/meetings.sqlite3
# LATENCY_PATH=data/latency.jsonl
RETENTION_DAYS=30
BRIDGE_TTL_SECONDS=600
SESSION_MAX_SECONDS=7200
EVENT_QUEUE_SIZE=256

# Text chat uses a separate text model; Gemini Live voice settings stay unchanged.
CHAT_AUTO_REPLY=true
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_WORKERS=2
CHAT_FOLLOWUP_SECONDS=60
CHAT_MAX_REPLY_AGE_SECONDS=120
CHAT_AUTO_PER_MINUTE=6
CHAT_PARTICIPANT_PER_MINUTE=3
CHAT_SEND_PER_MINUTE=20
CHAT_SEND_INTERVAL_SECONDS=1


# Optional screen understanding. OFF by default: review Recall/Gemini charges,
# meeting notice/consent, provider retention and public WSS before enabling.
SCREEN_ENABLED=false
VISION_ENABLED=false
VISION_PASSIVE_ENABLED=false
# Empty uses CHAT_MODEL. Actual image input is probed with a synthetic image first.
VISION_MODEL=
SCREEN_QUEUE_SIZE=8
SCREEN_MAX_STREAMS=2
SCREEN_SAMPLE_SECONDS=2
SCREEN_PACKET_MAX_AGE_SECONDS=2
SCREEN_FRAME_MAX_AGE_SECONDS=8
SCREEN_PREVIOUS_MAX_AGE_SECONDS=120
SCREEN_MAX_MESSAGE_BYTES=4000000
SCREEN_MAX_IMAGE_BYTES=2000000
SCREEN_MAX_PIXELS=4000000
SCREEN_MAX_EDGE=1920
SCREEN_CHANGE_THRESHOLD=0.015
VISION_TIMEOUT_SECONDS=20
VISION_PASSIVE_INTERVAL_SECONDS=30
